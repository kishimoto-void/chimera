"""
T3 Minimal Skeleton
===================

T3 is NOT a theory and NOT a solver.

Role:
    TPC
      ↓
    Residual Boundary
      ↓
    T3 Exploration
      ↓
    Candidate Structure
      ↓
    TPC re-entry

Core principle:
    T3 explores what TPC cannot currently operationalize.

IMPORTANT:
    - T3 does not define ≌.
    - T3 does not assert equivalence.
    - Candidates are hypotheses only.
    - Unknowns remain explicit.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from enum import Enum
from typing import Any, Dict, List


# ============================================================
# 1. TPC Boundary
# ============================================================

class BoundaryKind(Enum):
    NORMALIZATION = "normalization_gap"
    TRANSFORMATION = "transformation_gap"
    INVARIANT = "invariant_gap"
    PATH = "path_gap"
    OBSERVER = "observer_gap"
    SCALE = "scale_gap"
    UNKNOWN = "unknown"


@dataclass
class Residual:
    """
    Something TPC could not completely resolve.
    """

    kind: BoundaryKind
    description: str

    source: str = "TPC"

    observed: Any = None
    inferred: Any = None
    generated: Any = None


@dataclass
class TPCBoundary:
    """
    Input boundary exposed by TPC.
    """

    residuals: List[Residual] = field(
        default_factory=list
    )

    operational: List[str] = field(
        default_factory=list
    )

    non_operational: List[str] = field(
        default_factory=list
    )


# ============================================================
# 2. T3 Candidate
# ============================================================

class CandidateStatus(Enum):
    GENERATED = "generated"
    HYPOTHESIZED = "hypothesized"
    REJECTED = "rejected"
    UNRESOLVED = "unresolved"


@dataclass
class StructuralCandidate:
    """
    A structure generated by T3.

    This is NEVER treated as an established fact.
    """

    candidate_id: str

    source_residual: str

    structure: Dict[str, Any]

    transformation: str

    rationale: str

    status: CandidateStatus = CandidateStatus.GENERATED

    assumptions: List[str] = field(
        default_factory=list
    )


# ============================================================
# 3. T3 Exploration Result
# ============================================================

@dataclass
class T3Result:

    candidates: List[StructuralCandidate]

    remaining_residuals: List[Residual]

    notes: List[str] = field(
        default_factory=list
    )


# ============================================================
# 4. T3 Explorer
# ============================================================

class T3Explorer:
    """
    Minimal exploratory engine.

    T3 does not solve the residual.
    It generates candidate ways of looking at it.
    """

    def __init__(self) -> None:

        self.counter = 0

    def _next_id(self) -> str:

        self.counter += 1

        return f"T3-C{self.counter:04d}"

    # --------------------------------------------------------
    # Main entry
    # --------------------------------------------------------

    def explore(
        self,
        boundary: TPCBoundary,
    ) -> T3Result:

        candidates = []

        for residual in boundary.residuals:

            candidates.extend(
                self._explore_residual(residual)
            )

        return T3Result(
            candidates=candidates,
            remaining_residuals=boundary.residuals,
            notes=[
                "T3 generated candidates only",
                "No candidate is treated as truth",
                "≌ remains undefined",
                "Candidates should be returned to TPC",
            ],
        )

    # --------------------------------------------------------
    # Residual dispatch
    # --------------------------------------------------------

    def _explore_residual(
        self,
        residual: Residual,
    ) -> List[StructuralCandidate]:

        if residual.kind == BoundaryKind.NORMALIZATION:

            return self._normalization_candidates(
                residual
            )

        if residual.kind == BoundaryKind.TRANSFORMATION:

            return self._transformation_candidates(
                residual
            )

        if residual.kind == BoundaryKind.INVARIANT:

            return self._invariant_candidates(
                residual
            )

        if residual.kind == BoundaryKind.PATH:

            return self._path_candidates(
                residual
            )

        if residual.kind == BoundaryKind.OBSERVER:

            return self._observer_candidates(
                residual
            )

        if residual.kind == BoundaryKind.SCALE:

            return self._scale_candidates(
                residual
            )

        return self._unknown_candidates(
            residual
        )

    # --------------------------------------------------------
    # Candidate generators
    # --------------------------------------------------------

    def _normalization_candidates(
        self,
        residual: Residual,
    ) -> List[StructuralCandidate]:

        return [
            StructuralCandidate(
                candidate_id=self._next_id(),
                source_residual=residual.description,
                structure={
                    "operation":
                        "alternative_representation",
                },
                transformation=
                    "representation_change",
                rationale=
                    "Explore whether the residual "
                    "depends on representation.",
            )
        ]

    def _transformation_candidates(
        self,
        residual: Residual,
    ) -> List[StructuralCandidate]:

        return [
            StructuralCandidate(
                candidate_id=self._next_id(),
                source_residual=residual.description,
                structure={
                    "operation":
                        "explicit_transformation_candidate",
                },
                transformation=
                    "transformation_search",
                rationale=
                    "Search for an explicit transformation "
                    "rather than assuming one.",
            )
        ]

    def _invariant_candidates(
        self,
        residual: Residual,
    ) -> List[StructuralCandidate]:

        return [
            StructuralCandidate(
                candidate_id=self._next_id(),
                source_residual=residual.description,
                structure={
                    "operation":
                        "candidate_invariant",
                },
                transformation=
                    "invariant_search",
                rationale=
                    "Search for properties preserved "
                    "under observed transformations.",
            )
        ]

    def _path_candidates(
        self,
        residual: Residual,
    ) -> List[StructuralCandidate]:

        return [
            StructuralCandidate(
                candidate_id=self._next_id(),
                source_residual=residual.description,
                structure={
                    "operation":
                        "path_decomposition",
                    "compare":
                        [
                            "endpoint",
                            "intermediate_states",
                            "transition_sequence",
                        ],
                },
                transformation=
                    "path_expansion",
                rationale=
                    "Separate endpoint structure from "
                    "transition structure.",
            )
        ]

    def _observer_candidates(
        self,
        residual: Residual,
    ) -> List[StructuralCandidate]:

        return [
            StructuralCandidate(
                candidate_id=self._next_id(),
                source_residual=residual.description,
                structure={
                    "operation":
                        "observer_rotation",
                    "observers":
                        [
                            "literal",
                            "structural",
                            "alternative",
                        ],
                },
                transformation=
                    "observer_change",
                rationale=
                    "Determine whether the residual "
                    "is observer-dependent.",
            )
        ]

    def _scale_candidates(
        self,
        residual: Residual,
    ) -> List[StructuralCandidate]:

        return [
            StructuralCandidate(
                candidate_id=self._next_id(),
                source_residual=residual.description,
                structure={
                    "operation":
                        "scale_shift",
                    "scales":
                        [
                            "micro",
                            "meso",
                            "macro",
                        ],
                },
                transformation=
                    "scale_change",
                rationale=
                    "Test whether the residual survives "
                    "changes of observational scale.",
            )
        ]

    def _unknown_candidates(
        self,
        residual: Residual,
    ) -> List[StructuralCandidate]:

        return [
            StructuralCandidate(
                candidate_id=self._next_id(),
                source_residual=residual.description,
                structure={
                    "operation":
                        "unknown_structure_probe",
                },
                transformation=
                    "open_exploration",
                rationale=
                    "Residual has no registered exploration "
                    "operator.",
            )
        ]


# ============================================================
# 5. TPC Re-entry Adapter
# ============================================================

@dataclass
class TPCReentry:

    candidate_id: str

    input_structure: Dict[str, Any]

    mode: str = "candidate_only"


def prepare_for_tpc(
    result: T3Result,
) -> List[TPCReentry]:

    """
    Convert T3 candidates back into TPC-compatible inputs.

    No candidate is promoted to OBSERVED.
    """

    return [
        TPCReentry(
            candidate_id=candidate.candidate_id,
            input_structure=candidate.structure,
        )
        for candidate in result.candidates
    ]


# ============================================================
# 6. Minimal T3 Loop
# ============================================================

class T3Loop:

    def __init__(self) -> None:

        self.t3 = T3Explorer()

    def run_once(
        self,
        boundary: TPCBoundary,
    ) -> T3Result:

        return self.t3.explore(boundary)

    def reenter_tpc(
        self,
        result: T3Result,
    ) -> List[TPCReentry]:

        return prepare_for_tpc(result)


# ============================================================
# 7. Example
# ============================================================

if __name__ == "__main__":

    boundary = TPCBoundary(
        residuals=[
            Residual(
                kind=BoundaryKind.NORMALIZATION,
                description=
                    "A < B vs B > A",
            ),

            Residual(
                kind=BoundaryKind.PATH,
                description=
                    "same endpoint, different transition path",
            ),

            Residual(
                kind=BoundaryKind.INVARIANT,
                description=
                    "candidate invariant cannot be promoted",
            ),

            Residual(
                kind=BoundaryKind.SCALE,
                description=
                    "micro difference / macro overlap",
            ),
        ],

        operational=[
            "N1 normalization",
            "N2 normalization",
            "explicit transformations",
            "residual tracking",
        ],

        non_operational=[
            "positive ≌",
            "sufficient condition",
            "semantic identity",
        ],
    )

    loop = T3Loop()

    result = loop.run_once(boundary)

    print("=" * 60)
    print("T3 MINIMAL EXPLORATION")
    print("=" * 60)

    for candidate in result.candidates:

        print(
            f"\n[{candidate.candidate_id}]"
        )

        print(
            f"source: "
            f"{candidate.source_residual}"
        )

        print(
            f"transformation: "
            f"{candidate.transformation}"
        )

        print(
            f"structure: "
            f"{candidate.structure}"
        )

        print(
            f"status: "
            f"{candidate.status.value}"
        )

    print("\n--- TPC RE-ENTRY ---")

    reentry = loop.reenter_tpc(result)

    for item in reentry:

        print(
            item.candidate_id,
            "→",
            item.input_structure,
        )

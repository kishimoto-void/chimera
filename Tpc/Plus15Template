6. Code Specification

実験コードでは、最低限以下の条件を固定する。

from dataclasses import dataclass
from typing import Any


MIN_DRIFT = 0.15


@dataclass
class DriftHypothesis:
    value: Any
    level: float
    resolved: bool = False


@dataclass
class Transition:
    source: Any
    drift: DriftHypothesis
    result: Any
    difference: float | None
    state: str


def create_drift(value: Any, level: float = MIN_DRIFT):
    if level < MIN_DRIFT:
        raise ValueError(
            f"Drift level must be >= {MIN_DRIFT}"
        )

    return DriftHypothesis(
        value=value,
        level=level,
        resolved=False,
    )


def classify_difference(delta_in, delta_out):
    if delta_in is None or delta_out is None:
        return "UNRESOLVED"

    if delta_out < delta_in:
        return "CONTRACTION"

    if delta_out > delta_in:
        return "EXPANSION"

    return "STABLE"


def global_expansion(x1, solver, drift_level=MIN_DRIFT):
    drift = create_drift(x1, drift_level)

    z1 = solver(
        x=x1,
        drift=drift,
        mode="GLOBAL_EXPANSION",
        force_known_pattern=False,
        resolve=False,
    )

    return z1, drift


def macro_contraction(z1, solver, drift_level=MIN_DRIFT):
    result = solver(
        x=z1,
        drift=create_drift(z1, drift_level),
        mode="MACRO_CONTRACTION",
        force_known_pattern=False,
        resolve=False,
    )

    return result

